<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<!-- COWRIE HONEYPOT -->
<group name="cowrie,honeypot,">
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie\.</field>
    <description>Cowrie Honeypot: zdarzenie bazowe.</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.session\.connect$</field>
    <description>Cowrie Honeypot: nowe połączenie SSH (możliwy rekonesans) z adresu $(src_ip).</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.login\.failed$</field>
    <description>Cowrie Honeypot: nieudana próba logowania SSH z $(src_ip) na konto $(username).</description>
    <group>authentication_failed,</group>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100103" level="11" frequency="5" timeframe="60">
    <if_matched_sid>100102</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie Honeypot: wykryto atak Brute Force SSH z adresu $(src_ip).</description>
    <group>authentication_failed,attack,</group>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100104" level="10">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.login\.success$</field>
    <description>Cowrie Honeypot: atakujący z $(src_ip) zalogował się do pułapki na konto $(username).</description>
    <group>authentication_success,</group>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>


<!-- WIN 10 -->
<group name="sysmon,powershell,badusb,">
  <rule id="100200" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc|-encodedcommand)\s+</field>
    <description>Sysmon: wykryto podejrzane uruchomienie zakodowanego PowerShella (EncodedCommand) przez użytkownika $(win.eventdata.user) na $(win.system.computer).</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
  </rule>
</group>