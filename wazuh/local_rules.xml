<group name="cowrie,honeypot,">
  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="eventid">^cowrie\.</field>
    <description>Cowrie Honeypot: zdarzenie bazowe.</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.session\.connect$</field>
    <description>Cowrie Honeypot: nowe połączenie SSH (możliwy rekonesans) z adresu $(src_ip).</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>

  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.login\.failed$</field>
    <description>Cowrie Honeypot: nieudana próba logowania SSH z $(src_ip) na konto $(username).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100103" level="11" frequency="5" timeframe="60">
    <if_matched_sid>100102</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>Cowrie Honeypot: wykryto atak Brute Force SSH z adresu $(src_ip).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <rule id="100104" level="10">
    <if_sid>100100</if_sid>
    <field name="eventid">^cowrie\.login\.success$</field>
    <description>Cowrie Honeypot: atakujący z $(src_ip) zalogował się do pułapki na konto $(username).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>
</group>